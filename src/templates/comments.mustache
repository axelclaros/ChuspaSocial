{{!
    @template local_chuspasocial/comments

    List of comments of a post and the field to add a new one.

    Data attributes required for JS:
    * data-postid
    * data-action=add-comment

    Context variables required for this template:
    * postid - Id of the post the comments belong to.
    * comments - List of comments. Each comment has:
        * id - Comment id.
        * authorname - Full name of the author.
        * timecreated - Unix timestamp of the comment.
        * content - Comment text, already formatted with format_text().

    Example context (json):
    {
        "postid": 1,
        "comments": [
            {
                "id": 10,
                "authorname": "Luis Mamani",
                "timecreated": 1760003600,
                "content": "<p>¿Todavía está disponible?</p>"
            },
            {
                "id": 11,
                "authorname": "Ana Pérez",
                "timecreated": 1760007200,
                "content": "<p>Sí, escríbeme por mensaje.</p>"
            }
        ]
    }
}}
<section class="mt-2" data-postid="{{postid}}">
    <h4 class="h6">{{#str}} comments, local_chuspasocial {{/str}}</h4>
    <ul class="list-unstyled mb-2">
        {{#comments}}
        <li class="border-bottom py-2" data-commentid="{{id}}">
            <span class="font-weight-bold">{{authorname}}</span>
            <small class="text-muted ml-2">{{#userdate}} {{timecreated}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}</small>
            <div>{{{content}}}</div>
        </li>
        {{/comments}}
        {{^comments}}
        <li class="text-muted">{{#str}} nocomments, local_chuspasocial {{/str}}</li>
        {{/comments}}
    </ul>
    <input type="text" class="form-control" data-action="add-comment" placeholder="{{#str}} writecomment, local_chuspasocial {{/str}}" aria-label="{{#str}} addcomment, local_chuspasocial {{/str}}">
</section>
